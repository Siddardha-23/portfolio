{
  "uid": "portfolio-lambda-functions",
  "title": "Lambda Functions",
  "description": "Deep dive into individual Lambda function metrics - invocations, errors, duration, memory, and cold starts",
  "tags": ["portfolio", "lambda"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    { "title": "Service Overview", "type": "link", "url": "/d/portfolio-service-overview", "icon": "apps", "targetBlank": false },
    { "title": "API Gateway", "type": "link", "url": "/d/portfolio-api-gateway", "icon": "cloud", "targetBlank": false },
    { "title": "Logs Explorer", "type": "link", "url": "/d/portfolio-logs-explorer", "icon": "file-alt", "targetBlank": false },
    { "title": "X-Ray Traces", "type": "link", "url": "/d/portfolio-xray-traces", "icon": "sitemap", "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "function",
        "type": "query",
        "label": "Function",
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "query": "dimension_values($region, AWS/Lambda, Invocations, FunctionName)",
        "regex": "/^portfolio-.*/",
        "current": { "selected": true, "text": "portfolio-visitor", "value": "portfolio-visitor" },
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "region",
        "type": "custom",
        "query": "us-east-1",
        "current": { "text": "us-east-1", "value": "us-east-1" },
        "options": [{ "text": "us-east-1", "value": "us-east-1", "selected": true }],
        "label": "Region",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Invocations",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/Lambda",
        "metricName": "Invocations",
        "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "",
        "region": "$region",
        "matchExact": true,
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 2,
      "title": "Errors",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/Lambda",
        "metricName": "Errors",
        "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "",
        "region": "$region",
        "matchExact": true,
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Errors",
          "statistic": "Sum",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "",
          "region": "$region",
          "matchExact": true,
          "refId": "errors",
          "hide": true
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Invocations",
          "statistic": "Sum",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "",
          "region": "$region",
          "matchExact": true,
          "refId": "invocations",
          "hide": true
        },
        {
          "datasource": { "type": "__expr__", "uid": "__expr__" },
          "refId": "C",
          "type": "math",
          "expression": "$errors / $invocations * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 4,
      "title": "Avg Duration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/Lambda",
        "metricName": "Duration",
        "statistic": "Average",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "",
        "region": "$region",
        "matchExact": true,
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 5000 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 5,
      "title": "Throttles",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/Lambda",
        "metricName": "Throttles",
        "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "",
        "region": "$region",
        "matchExact": true,
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },

    {
      "id": 100,
      "title": "Invocations & Errors",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Invocations Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/Lambda",
        "metricName": "Invocations",
        "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "300",
        "region": "$region",
        "matchExact": true,
        "refId": "A",
        "alias": "Invocations"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "auto", "pointSize": 5, "gradientMode": "opacity" },
          "color": { "fixedColor": "blue", "mode": "fixed" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean", "max"] }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 11,
      "title": "Errors Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/Lambda",
        "metricName": "Errors",
        "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "300",
        "region": "$region",
        "matchExact": true,
        "refId": "A",
        "alias": "Errors"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "fillOpacity": 30, "lineWidth": 2, "drawStyle": "bars", "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max", "lastNotNull"] }, "tooltip": { "mode": "single", "sort": "none" } }
    },

    {
      "id": 101,
      "title": "Duration & Performance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "title": "Duration Percentiles (avg / p50 / p90 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Duration",
          "statistic": "Average",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300",
          "region": "$region",
          "matchExact": true,
          "refId": "A",
          "alias": "avg"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Duration",
          "statistic": "p50",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300",
          "region": "$region",
          "matchExact": true,
          "refId": "B",
          "alias": "p50"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Duration",
          "statistic": "p90",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300",
          "region": "$region",
          "matchExact": true,
          "refId": "C",
          "alias": "p90"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Duration",
          "statistic": "p99",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300",
          "region": "$region",
          "matchExact": true,
          "refId": "D",
          "alias": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 5, "lineWidth": 2, "showPoints": "never", "gradientMode": "scheme" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "avg" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p90" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 21,
      "title": "Concurrent Executions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/Lambda",
        "metricName": "ConcurrentExecutions",
        "statistic": "Maximum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "300",
        "region": "$region",
        "matchExact": true,
        "refId": "A",
        "alias": "Concurrent"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "auto", "pointSize": 5, "gradientMode": "opacity" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] }, "tooltip": { "mode": "single", "sort": "none" } }
    },

    {
      "id": 102,
      "title": "Cold Starts & Memory",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "title": "Cold Starts",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$function", "name": "/aws/lambda/$function" }
        ],
        "expression": "filter @type = 'REPORT' and ispresent(@initDuration) | stats count(*) as cold_starts, avg(@initDuration) as avg_init_ms, max(@initDuration) as max_init_ms, avg(@duration) as avg_duration_ms by bin(1h) as period | sort period desc",
        "region": "$region",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "cold_starts" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "color", "value": { "mode": "continuous-reds" } }] },
          { "matcher": { "id": "byName", "options": "avg_init_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "max_init_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "avg_duration_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "cold_starts", "desc": true }] }
    },
    {
      "id": 31,
      "title": "Memory Utilization",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$function", "name": "/aws/lambda/$function" }
        ],
        "expression": "filter @type = 'REPORT' | stats avg(@memorySize / 1048576) as allocated_MB, avg(@maxMemoryUsed / 1048576) as avg_used_MB, max(@maxMemoryUsed / 1048576) as max_used_MB, avg(@maxMemoryUsed / @memorySize * 100) as avg_utilization_pct, count(*) as invocations by bin(1h) as period | sort period desc",
        "region": "$region",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "allocated_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "avg_used_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "max_used_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "avg_utilization_pct" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "avg_utilization_pct", "desc": true }] }
    },

    {
      "id": 103,
      "title": "Recent Invocations (Logs)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 40,
      "title": "Recent Invocation Reports",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$function", "name": "/aws/lambda/$function" }
        ],
        "expression": "filter @type = 'REPORT' | fields @timestamp, @duration as duration_ms, @maxMemoryUsed / 1048576 as memory_used_MB, @memorySize / 1048576 as memory_allocated_MB, ispresent(@initDuration) as is_cold_start, @initDuration as init_duration_ms | sort @timestamp desc | limit 50",
        "region": "$region",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "duration_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "memory_used_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "memory_allocated_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "init_duration_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "is_cold_start" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 1 }] } }] }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}