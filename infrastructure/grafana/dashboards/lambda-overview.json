        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Throttles",
          "statistic": "Sum",
          "dimensions": {},
          "period": "",
          "region": "$region",
          "matchExact": false,
          "refId": "A",
          "id": "throttles_total"
