{
  "uid": "portfolio-lambda-functions",
  "title": "Lambda Functions",
  "description": "Deep dive into Lambda function metrics — select a function to analyze invocations, errors, duration, memory, and cold starts",
  "tags": ["portfolio", "lambda"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    { "title": "Service Overview", "type": "link", "url": "/d/portfolio-service-overview", "icon": "apps", "targetBlank": false },
    { "title": "API Gateway", "type": "link", "url": "/d/portfolio-api-gateway", "icon": "cloud", "targetBlank": false },
    { "title": "Logs Explorer", "type": "link", "url": "/d/portfolio-logs-explorer?var-service=portfolio-${function}", "icon": "file-alt", "targetBlank": false },
    { "title": "X-Ray Traces", "type": "link", "url": "/d/portfolio-xray-traces", "icon": "sitemap", "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "function",
        "type": "custom",
        "label": "Function",
        "query": "portfolio-visitor,portfolio-auth,portfolio-jobs-resume,portfolio-chat,portfolio-infra",
        "current": { "text": "All", "value": ["$__all"] },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "portfolio-visitor", "value": "portfolio-visitor" },
          { "text": "portfolio-auth", "value": "portfolio-auth" },
          { "text": "portfolio-jobs-resume", "value": "portfolio-jobs-resume" },
          { "text": "portfolio-chat", "value": "portfolio-chat" },
          { "text": "portfolio-infra", "value": "portfolio-infra" }
        ],
        "includeAll": true,
        "multi": true,
        "allValue": ""
      },
      {
        "name": "region",
        "type": "custom",
        "query": "us-east-1",
        "current": { "text": "us-east-1", "value": "us-east-1" },
        "options": [{ "text": "us-east-1", "value": "us-east-1", "selected": true }],
        "label": "Region",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Invocations",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Invocations", "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "", "region": "$region", "matchExact": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 2,
      "title": "Errors",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Errors", "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "", "region": "$region", "matchExact": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Errors", "statistic": "Sum",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "", "region": "$region", "matchExact": true, "refId": "A", "hide": true
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Invocations", "statistic": "Sum",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "", "region": "$region", "matchExact": true, "refId": "B", "hide": true
        },
        {
          "datasource": { "type": "__expr__", "uid": "__expr__" },
          "refId": "C",
          "type": "math",
          "expression": "$A / $B * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 4,
      "title": "Avg Duration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Duration", "statistic": "Average",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "", "region": "$region", "matchExact": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 5000 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 5,
      "title": "Throttles",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Throttles", "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "", "region": "$region", "matchExact": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 100,
      "title": "Invocations & Errors",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Invocations Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Invocations", "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "300", "region": "$region", "matchExact": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "gradientMode": "opacity", "stacking": { "mode": "normal" } },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "title": "Errors Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Errors", "statistic": "Sum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "300", "region": "$region", "matchExact": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "lineWidth": 2, "drawStyle": "bars", "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 101,
      "title": "Duration & Performance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "title": "Duration Percentiles (avg / p50 / p90 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Duration", "statistic": "Average",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300", "region": "$region", "matchExact": true, "refId": "A", "alias": "avg"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Duration", "statistic": "p50",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300", "region": "$region", "matchExact": true, "refId": "B", "alias": "p50"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Duration", "statistic": "p90",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300", "region": "$region", "matchExact": true, "refId": "C", "alias": "p90"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
          "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "Duration", "statistic": "p99",
          "dimensions": { "FunctionName": ["$function"] },
          "period": "300", "region": "$region", "matchExact": true, "refId": "D", "alias": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 5, "lineWidth": 2, "showPoints": "never", "gradientMode": "scheme" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "avg" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p90" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 21,
      "title": "Concurrent Executions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics", "namespace": "AWS/Lambda", "metricName": "ConcurrentExecutions", "statistic": "Maximum",
        "dimensions": { "FunctionName": ["$function"] },
        "period": "300", "region": "$region", "matchExact": true, "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "gradientMode": "opacity" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 102,
      "title": "Cold Starts & Memory",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "title": "Cold Starts",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-visitor", "name": "/aws/lambda/portfolio-visitor" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-auth", "name": "/aws/lambda/portfolio-auth" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-jobs-resume", "name": "/aws/lambda/portfolio-jobs-resume" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-chat", "name": "/aws/lambda/portfolio-chat" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-infra", "name": "/aws/lambda/portfolio-infra" }
        ],
        "expression": "filter @type = 'REPORT' and ispresent(@initDuration) | stats count(*) as cold_starts, avg(@initDuration) as avg_init_ms, max(@initDuration) as max_init_ms, avg(@duration) as avg_duration_ms by @logStream as function | sort cold_starts desc",
        "region": "$region",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "cold_starts" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "color", "value": { "mode": "continuous-reds" } }] },
          { "matcher": { "id": "byName", "options": "avg_init_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "max_init_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "avg_duration_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "cold_starts", "desc": true }] }
    },
    {
      "id": 31,
      "title": "Memory Utilization",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-visitor", "name": "/aws/lambda/portfolio-visitor" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-auth", "name": "/aws/lambda/portfolio-auth" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-jobs-resume", "name": "/aws/lambda/portfolio-jobs-resume" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-chat", "name": "/aws/lambda/portfolio-chat" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-infra", "name": "/aws/lambda/portfolio-infra" }
        ],
        "expression": "filter @type = 'REPORT' | stats avg(@memorySize / 1048576) as allocated_MB, avg(@maxMemoryUsed / 1048576) as avg_used_MB, max(@maxMemoryUsed / 1048576) as max_used_MB, avg(@maxMemoryUsed / @memorySize * 100) as avg_utilization_pct, count(*) as invocations by @logStream as function | sort avg_utilization_pct desc",
        "region": "$region",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "allocated_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "avg_used_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "max_used_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "avg_utilization_pct" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "avg_utilization_pct", "desc": true }] }
    },
    {
      "id": 103,
      "title": "Performance Over Time (Logs)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 40,
      "title": "Hourly Performance Summary",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-visitor", "name": "/aws/lambda/portfolio-visitor" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-auth", "name": "/aws/lambda/portfolio-auth" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-jobs-resume", "name": "/aws/lambda/portfolio-jobs-resume" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-chat", "name": "/aws/lambda/portfolio-chat" },
          { "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/portfolio-infra", "name": "/aws/lambda/portfolio-infra" }
        ],
        "expression": "filter @type = 'REPORT' | stats count(*) as invocations, avg(@duration) as avg_ms, max(@duration) as max_ms, avg(@maxMemoryUsed / 1048576) as avg_mem_MB, sum(ispresent(@initDuration)) as cold_starts by bin(1h) | sort bin(1h) desc",
        "region": "$region",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "avg_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "max_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "avg_mem_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "cold_starts" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 1 }] } }] }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}
