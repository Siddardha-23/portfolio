{
  "title": "Portfolio - Logs & Traces",
  "description": "CloudWatch Logs Insights and X-Ray trace exploration",
  "tags": ["portfolio", "logs", "xray", "aws"],
  "timezone": "browser",
  "refresh": "5m",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "portfolio-visitor,portfolio-auth,portfolio-jobs-resume,portfolio-chat,portfolio-infra",
        "current": { "text": "portfolio-visitor", "value": "portfolio-visitor" },
        "options": [
          { "text": "portfolio-visitor", "value": "portfolio-visitor", "selected": true },
          { "text": "portfolio-auth", "value": "portfolio-auth" },
          { "text": "portfolio-jobs-resume", "value": "portfolio-jobs-resume" },
          { "text": "portfolio-chat", "value": "portfolio-chat" },
          { "text": "portfolio-infra", "value": "portfolio-infra" }
        ],
        "multi": false,
        "label": "Service"
      },
      {
        "name": "region",
        "type": "custom",
        "query": "us-east-1",
        "current": { "text": "us-east-1", "value": "us-east-1" },
        "options": [{ "text": "us-east-1", "value": "us-east-1", "selected": true }],
        "label": "Region"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [{ "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$service", "name": "/aws/lambda/$service" }],
        "expression": "filter @message like /(?i)(error|exception|traceback|critical)/ | fields @timestamp, @message | sort @timestamp desc | limit 50",
        "region": "$region",
        "refId": "A",
        "id": "recent_errors"
      }]
    },
    {
      "id": 2,
      "title": "Cold Start Analysis",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [{ "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$service", "name": "/aws/lambda/$service" }],
        "expression": "filter @type = 'REPORT' | fields @timestamp, @initDuration as coldStartMs, @duration as durationMs, @maxMemoryUsed / 1048576 as memUsedMB | filter ispresent(@initDuration) | sort @timestamp desc | limit 25",
        "region": "$region",
        "refId": "A",
        "id": "cold_starts"
      }]
    },
    {
      "id": 3,
      "title": "Performance Summary",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [{ "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$service", "name": "/aws/lambda/$service" }],
        "expression": "filter @type = 'REPORT' | stats avg(@duration) as avgDurationMs, max(@duration) as maxDurationMs, avg(@maxMemoryUsed) / 1048576 as avgMemMB, count(*) as invocations, sum(ispresent(@initDuration)) as coldStarts by bin(1h)",
        "region": "$region",
        "refId": "A",
        "id": "perf_summary"
      }]
    },
    {
      "id": 4,
      "title": "Log Volume",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [{ "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$service", "name": "/aws/lambda/$service" }],
        "expression": "stats count(*) as logCount by bin(5m)",
        "region": "$region",
        "refId": "A",
        "id": "log_volume"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "lineWidth": 2 } } }
    },
    {
      "id": 5,
      "title": "Error Volume",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [{ "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$service", "name": "/aws/lambda/$service" }],
        "expression": "filter @message like /(?i)(error|exception|traceback)/ | stats count(*) as errors by bin(5m)",
        "region": "$region",
        "refId": "A",
        "id": "error_volume"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "lineWidth": 2 } } }
    },
    {
      "id": 6,
      "title": "All Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Logs",
        "logGroups": [{ "arn": "arn:aws:logs:us-east-1:024230653681:log-group:/aws/lambda/$service", "name": "/aws/lambda/$service" }],
        "expression": "fields @timestamp, @message | sort @timestamp desc | limit 100",
        "region": "$region",
        "refId": "A",
        "id": "all_logs"
      }]
    }
  ]
}
