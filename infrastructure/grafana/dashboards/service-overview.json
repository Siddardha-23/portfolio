{
  "uid": "portfolio-service-overview",
  "title": "Service Overview",
  "description": "Single pane of glass — health and performance across all portfolio services",
  "tags": ["portfolio", "overview"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "links": [
    { "title": "API Gateway", "type": "link", "url": "/d/portfolio-api-gateway", "icon": "cloud", "targetBlank": false, "tooltip": "API Gateway deep dive" },
    { "title": "Lambda Functions", "type": "link", "url": "/d/portfolio-lambda-functions", "icon": "bolt", "targetBlank": false, "tooltip": "Lambda function metrics" },
    { "title": "Logs Explorer", "type": "link", "url": "/d/portfolio-logs-explorer", "icon": "file-alt", "targetBlank": false, "tooltip": "Search and analyze logs" },
    { "title": "X-Ray Traces", "type": "link", "url": "/d/portfolio-xray-traces", "icon": "sitemap", "targetBlank": false, "tooltip": "Distributed tracing" }
  ],
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "custom",
        "query": "us-east-1",
        "current": { "text": "us-east-1", "value": "us-east-1" },
        "options": [{ "text": "us-east-1", "value": "us-east-1", "selected": true }],
        "label": "Region",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Error Spikes",
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "enable": true,
        "iconColor": "red",
        "hide": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total API Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "cloudwatch", "uid": "P034F075C744B399F" },
        "queryMode": "Metrics",
        "namespace": "AWS/ApiGateway",
        "metricName": "Count",
        "statistic": "Sum",
        "dimensions": { "ApiId": ["p456vbvclk"] },
        "period": "",
        "region": "$region",
        "matchExact": true,
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "links": [{ "title": "View API Gateway", "url": "/d/portfolio-api-gateway" }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background_solid", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 2,
      "title": "Total Invocations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
