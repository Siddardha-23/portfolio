# =============================================================================
# Terraform Variables Configuration
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values
# 
# IMPORTANT: 
# - NEVER commit terraform.tfvars to version control!
# - Secrets are stored in AWS SSM Parameter Store (SecureString)
# - After first deploy, you can manage secrets directly in AWS Console:
#   AWS Console → Systems Manager → Parameter Store
# =============================================================================

# AWS Configuration
aws_region   = "us-east-1"
project_name = "portfolio"
environment  = "prod"

# Domain Configuration (already set up in Route 53)
domain_name = "manneharshithsiddardha.com"

# =============================================================================
# SECRETS - Only needed for FIRST deployment
# After initial deploy, manage these in AWS SSM Parameter Store console
# =============================================================================

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas → Database → Connect → Connect your application
mongodb_uri = "REPLACE_WITH_YOUR_MONGODB_URI"

# JWT Secret Key (generate a strong random key)
# Example: openssl rand -hex 32
jwt_secret_key = "your-super-secret-jwt-key-here-change-this"

# IPInfo Token (optional - for IP geolocation)
# Get free token at: https://ipinfo.io/signup
ipinfo_token = ""

# =============================================================================
# Gmail Integration (optional)
# =============================================================================
# Enables auto-update of application status from emails on the Applications tab.
#
# Setup steps:
#   1. Google Cloud Console → APIs & Services → Library → enable Gmail API.
#   2. APIs & Services → Credentials → Create OAuth client ID → "Web application".
#   3. Authorized redirect URIs (add BOTH):
#        https://manneharshithsiddardha.com/oauth/gmail/callback
#        http://localhost:5173/oauth/gmail/callback
#      The redirect URI registered in Google MUST exactly match
#      `google_oauth_redirect_uri` (or the default https://<domain>/oauth/gmail/callback).
#   4. OAuth consent screen → "Testing" mode → add yourself as a test user.
#      (Public/Production verification requires Google's CASA review.)
#   5. Generate the encryption key:
#        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#      ⚠️ Store this key securely. Rotating it invalidates every linked user's
#      Gmail connection — they'll have to re-link.
#
# Leave all four blank to keep the feature disabled (UI hides itself).
google_oauth_client_id     = ""
google_oauth_client_secret = ""
google_oauth_redirect_uri  = "" # leave blank to default to https://<domain_name>/oauth/gmail/callback
gmail_token_encryption_key = ""

# =============================================================================
# Lambda Configuration
# =============================================================================

# Memory size in MB (512 is good balance of cost/performance)
# More memory = faster CPU = faster cold starts
lambda_memory_size = 512

# Timeout in seconds
lambda_timeout = 30

# =============================================================================
# Feature Flags
# =============================================================================

# Enable AWS WAF for additional security (adds ~$5/month)
enable_waf = false

# Enable CloudWatch logging
enable_logging = true

# =============================================================================
# Grafana on GCP (optional)
# =============================================================================
# Creates an IAM user with read-only CloudWatch/X-Ray access.
# Credentials are used by the Grafana instance on GCP (see infrastructure/terraform-gcp/).
#
# 1. Set enable_grafana = true
# 2. terraform apply
# 3. terraform output -raw grafana_aws_access_key_id
# 4. terraform output -raw grafana_aws_secret_access_key
# 5. Use these in infrastructure/terraform-gcp/terraform.tfvars

enable_grafana = false

# =============================================================================
# Datadog (optional) — Serverless APM + SLOs + golden-signals dashboards
# =============================================================================
# Adds Datadog Lambda Extension + Python tracer layers to every service, and
# provisions a golden-signals dashboard, two SLOs, four monitors, and a
# synthetic API test via the Datadog Terraform provider.
#
# Setup:
#   1. Sign up at https://www.datadoghq.com/ (free trial → free tier)
#   2. Pick your site. US1 (datadoghq.com) is the original us-east-1 region —
#      lowest latency for AWS us-east-1-hosted workloads and the default here.
#      The site is locked to your org at signup; you cannot change it later.
#   3. Organization Settings → API Keys → create "portfolio-prod"
#   4. Organization Settings → Application Keys → create "portfolio-prod-tf"
#   5. Fill the four values below and set enable_datadog = true
#   6. terraform apply
#
# Cost: free trial covers everything for 14 days. After trial, set
#   datadog_trace_sample_rate low (0.1 = 10%) to stay inside free tier limits.

enable_datadog                  = false
datadog_api_key                 = "" # from DD UI → Organization Settings → API Keys
datadog_app_key                 = "" # from DD UI → Organization Settings → Application Keys
datadog_site                    = "datadoghq.com" # US1 (us-east-1). Use us5.datadoghq.com / datadoghq.eu / ap1.datadoghq.com if you picked a different region.
datadog_extension_layer_version = 70  # bump as Datadog releases
datadog_python_layer_version    = 123 # bump as Datadog releases (123 = Flask 3.1-compatible)
datadog_trace_sample_rate       = 0.1
datadog_synthetic_email         = "" # e.g. harshith.siddardha@gmail.com
