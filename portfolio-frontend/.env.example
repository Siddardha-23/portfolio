# Example environment variables for frontend development
# Copy this file to .env.local for local development

# API URL - Use local backend during development
VITE_API_URL=http://localhost:5000/api

# For production (deployed via CI/CD):
# VITE_API_URL=https://manneharshithsiddardha.com/api

# --- Datadog Browser RUM (optional) -------------------------------------
# Set during CI/CD from `terraform output`. Leaving these unset disables RUM.
#   VITE_DD_RUM_APPLICATION_ID=$(terraform output -raw datadog_rum_application_id)
#   VITE_DD_RUM_CLIENT_TOKEN=$(terraform output -raw datadog_rum_client_token)
# VITE_DD_RUM_APPLICATION_ID=
# VITE_DD_RUM_CLIENT_TOKEN=
# VITE_DD_RUM_SITE=datadoghq.com
# VITE_DD_RUM_ENV=prod
# VITE_DD_RUM_VERSION=local
